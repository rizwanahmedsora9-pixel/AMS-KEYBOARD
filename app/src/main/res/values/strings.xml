    <string name="setup_title">Set up AMS Keyboard</string>
    <string name="setup_step_enable_title">1. Enable the keyboard</string>
    <string name="setup_step_enable_body">Turn on AMS Keyboard in the system input-method list so Android allows it to appear.</string>
    <string name="setup_step_select_title">2. Choose it as your keyboard</string>
    <string name="setup_step_select_body">Open the keyboard picker and select AMS Keyboard.</string>
    <string name="setup_step_update_title">3. Updates install over the old version</string>
    <string name="setup_step_update_body">Every new APK keeps the same app ID and signing key, so installing an update replaces the previous version in place. Your settings and clipboard history stay intact.</string>
