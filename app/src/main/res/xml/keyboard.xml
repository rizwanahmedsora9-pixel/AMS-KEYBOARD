<?xml version="1.0" encoding="utf-8"?>
<!--
  Letters layout with dedicated Numeric Layer on top.

  Row 1: Numbers (1 2 3 4 5 6 7 8 9 0) directly above QWERTY for instant access.
  Row 2: QWERTY letters with secondary symbol popups.
  Row 3: ASDF letters with punctuation popups.
  Row 4: Shift, ZXCV letters, Backspace.
  Row 5: Ctrl, Alt, ?123, Comma, Space, Period, Emoji, Enter.
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="45dp"
    android:horizontalGap="0dp"
    android:verticalGap="3dp">

    <!-- Row 1: Dedicated Numeric Layer above QWERTY -->
    <Row>
        <Key android:codes="49" android:keyLabel="1" android:popupCharacters="!~" android:keyEdgeFlags="left" />
        <Key android:codes="50" android:keyLabel="2" android:popupCharacters="@" />
        <Key android:codes="51" android:keyLabel="3" android:popupCharacters="#" />
        <Key android:codes="52" android:keyLabel="4" android:popupCharacters="$€£¥₹¢" />
        <Key android:codes="53" android:keyLabel="5" android:popupCharacters="%‰" />
        <Key android:codes="54" android:keyLabel="6" android:popupCharacters="^" />
        <Key android:codes="55" android:keyLabel="7" android:popupCharacters="&amp;" />
        <Key android:codes="56" android:keyLabel="8" android:popupCharacters="*°" />
        <Key android:codes="57" android:keyLabel="9" android:popupCharacters="([{&lt;" />
        <Key android:codes="48" android:keyLabel="0" android:popupCharacters=")]}&gt;" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 2: QWERTY -->
    <Row>
        <Key android:codes="113" android:keyLabel="q" android:popupCharacters="+" android:keyEdgeFlags="left" />
        <Key android:codes="119" android:keyLabel="w" android:popupCharacters="×" />
        <Key android:codes="101" android:keyLabel="e" android:popupCharacters="÷" />
        <Key android:codes="114" android:keyLabel="r" android:popupCharacters="=" />
        <Key android:codes="116" android:keyLabel="t" android:popupCharacters="/" />
        <Key android:codes="121" android:keyLabel="y" android:popupCharacters="\\" />
        <Key android:codes="117" android:keyLabel="u" android:popupCharacters="_" />
        <Key android:codes="105" android:keyLabel="i" android:popupCharacters="-" />
        <Key android:codes="111" android:keyLabel="o" android:popupCharacters="'" />
        <Key android:codes="112" android:keyLabel="p" android:popupCharacters="&quot;" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 3: ASDFGHJKL (9 keys staggered) -->
    <Row android:keyWidth="11.11%p">
        <Key android:codes="97" android:keyLabel="a" android:popupCharacters=";" android:keyWidth="11.12%p" android:keyEdgeFlags="left" />
        <Key android:codes="115" android:keyLabel="s" android:popupCharacters=":" />
        <Key android:codes="100" android:keyLabel="d" android:popupCharacters="?" />
        <Key android:codes="102" android:keyLabel="f" android:popupCharacters="!" />
        <Key android:codes="103" android:keyLabel="g" android:popupCharacters="&amp;" />
        <Key android:codes="104" android:keyLabel="h" android:popupCharacters="&quot;" />
        <Key android:codes="106" android:keyLabel="j" android:popupCharacters="'" />
        <Key android:codes="107" android:keyLabel="k" android:popupCharacters="&lt;" />
        <Key android:codes="108" android:keyLabel="l" android:popupCharacters="&gt;" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 4: Shift, ZXCVBNM, Backspace -->
    <Row android:keyWidth="10.71%p">
        <Key android:codes="-1" android:keyIcon="@drawable/ic_shift" android:keyLabel="⇧"
            android:keyWidth="12.5%p" android:isModifier="true" android:isSticky="true"
            android:keyEdgeFlags="left" />
        <Key android:codes="122" android:keyLabel="z" android:popupCharacters="[" />
        <Key android:codes="120" android:keyLabel="x" android:popupCharacters="]" />
        <Key android:codes="99" android:keyLabel="c" android:popupCharacters="{" />
        <Key android:codes="118" android:keyLabel="v" android:popupCharacters="}" />
        <Key android:codes="98" android:keyLabel="b" android:popupCharacters="•" />
        <Key android:codes="110" android:keyLabel="n" android:popupCharacters="…" />
        <Key android:codes="109" android:keyLabel="m" android:popupCharacters="|" />
        <Key android:codes="-5" android:keyIcon="@drawable/ic_backspace_wide" android:keyLabel="⌫"
            android:keyWidth="12.5%p" android:isRepeatable="true" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 5: Ctrl / Alt / symbols / space / emoji / enter. 11+9+12+9+28+9+10+12 = 100% -->
    <Row>
        <Key android:codes="1001" android:keyLabel="Ctrl" android:keyWidth="11%p"
            android:isModifier="true" android:keyEdgeFlags="left" />
        <Key android:codes="1002" android:keyLabel="Alt" android:keyWidth="9%p"
            android:isModifier="true" />
        <Key android:codes="-2" android:keyLabel="\?123" android:keyWidth="12%p" />
        <Key android:codes="44" android:keyLabel="," android:popupCharacters="&lt;" android:keyWidth="9%p" />
        <Key android:codes="32" android:keyLabel="English (US)" android:keyWidth="28%p" />
        <Key android:codes="46" android:keyLabel="." android:popupCharacters="&gt;" android:keyWidth="9%p" />
        <Key android:codes="-1001" android:keyLabel="☺" android:keyWidth="10%p" />
        <Key android:codes="10" android:keyIcon="@drawable/ic_enter" android:keyLabel="↵"
            android:keyWidth="12%p" android:keyEdgeFlags="right" />
    </Row>
</Keyboard>
