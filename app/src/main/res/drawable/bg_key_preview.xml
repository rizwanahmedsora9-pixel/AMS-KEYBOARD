<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mech_key_shadow" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mech_key_face" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="@color/ime_accent" />
        </shape>
    </item>
</layer-list>
