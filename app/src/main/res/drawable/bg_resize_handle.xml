<?xml version="1.0" encoding="utf-8"?>
<!-- A slim grabber pill, drawn inside a full-width touch zone so the whole strip is draggable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center" android:width="46dp" android:height="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#54686F" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
