<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mech_key_shadow" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="3dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mech_key_face_pressed" />
                    <corners android:radius="7dp" />
                    <stroke android:width="1.5dp" android:color="@color/ime_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mech_key_shadow" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mech_key_face" />
                    <corners android:radius="7dp" />
                    <stroke android:width="1dp" android:color="@color/mech_key_highlight" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
