<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background">

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_settings_header"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/app_name"
                        android:src="@mipmap/ic_launcher" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textColor="@color/settings_text_primary"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/version_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_settings_pill_warn"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/setup_needs_enable"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Setup steps -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/setup_title" />

            <LinearLayout
                style="@style/Card">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/setup_step_enable_title" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/setup_step_enable_body" />

                <Button
                    android:id="@+id/button_enable"
                    style="@style/PrimaryButton"
                    android:text="@string/setup_enable_button" />

                <Button
                    android:id="@+id/button_select"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/setup_select_button" />

                <TextView
                    style="@style/SettingTitle"
                    android:layout_marginTop="20dp"
                    android:text="@string/setup_step_select_title" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/setup_step_select_body" />

                <TextView
                    style="@style/SettingTitle"
                    android:layout_marginTop="20dp"
                    android:text="@string/setup_step_update_title" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/setup_step_update_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button_refresh"
                        style="@style/SecondaryButton"
                        android:layout_marginEnd="8dp"
                        android:text="@string/setup_refresh" />

                    <Button
                        android:id="@+id/button_test"
                        style="@style/SecondaryButton"
                        android:text="@string/setup_open_keyboard_button" />
                </LinearLayout>
            </LinearLayout>

            <!-- Typing -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/settings_group_typing" />

            <LinearLayout
                style="@style/Card">

                <include
                    android:id="@+id/row_auto_correct"
                    layout="@layout/item_setting_switch" />

                <include
                    android:id="@+id/row_suggestions"
                    layout="@layout/item_setting_switch" />

                <include
                    android:id="@+id/row_auto_capitalize"
                    layout="@layout/item_setting_switch" />

                <include
                    android:id="@+id/row_double_space"
                    layout="@layout/item_setting_switch" />

                <include
                    android:id="@+id/row_long_press"
                    layout="@layout/item_setting_switch" />

            </LinearLayout>

            <!-- Feedback -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/settings_group_feedback" />

            <LinearLayout
                style="@style/Card">

                <include
                    android:id="@+id/row_sound"
                    layout="@layout/item_setting_switch" />

                <include
                    android:id="@+id/row_vibrate"
                    layout="@layout/item_setting_switch" />

                <include
                    android:id="@+id/row_preview"
                    layout="@layout/item_setting_switch" />

                <include
                    android:id="@+id/row_alt_toolbar"
                    layout="@layout/item_setting_switch" />
            </LinearLayout>

            <!-- Size and spacing -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/settings_group_keyboard" />

            <LinearLayout
                style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/setting_keyboard_height_title" />

                    <TextView
                        android:id="@+id/height_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ime_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/setting_keyboard_height_summary" />

                <SeekBar
                    android:id="@+id/seek_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="70%"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="100%"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="11sp"
                        android:textAlignment="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="150%"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/settings_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/setting_row_gap_title" />

                    <TextView
                        android:id="@+id/row_gap_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ime_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/setting_row_gap_summary" />

                <SeekBar
                    android:id="@+id/seek_row_gap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Clipboard -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/settings_group_clipboard" />

            <LinearLayout
                style="@style/Card">

                <include
                    android:id="@+id/row_clipboard_history"
                    layout="@layout/item_setting_switch" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/setting_clipboard_limit_title" />

                    <TextView
                        android:id="@+id/clipboard_limit_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ime_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/setting_clipboard_limit_summary" />

                <SeekBar
                    android:id="@+id/seek_clipboard_limit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/button_clear_clipboard"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="10dp"
                    android:text="@string/clipboard_clear" />
            </LinearLayout>

            <!-- Frequently asked questions, written plainly -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/settings_group_about" />

            <LinearLayout
                style="@style/Card">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/faq_updates_title" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/faq_updates_body" />

                <TextView
                    style="@style/SettingTitle"
                    android:layout_marginTop="18dp"
                    android:text="@string/faq_clipboard_title" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/faq_clipboard_body" />

                <TextView
                    style="@style/SettingTitle"
                    android:layout_marginTop="18dp"
                    android:text="@string/faq_copy_all_title" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/faq_copy_all_body" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/settings_divider" />

                <Button
                    android:id="@+id/button_clear_all_clips"
                    style="@style/SecondaryButton"
                    android:textColor="@color/danger"
                    android:text="@string/clipboard_clear" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/settings_divider" />

                <Button
                    android:id="@+id/button_reset"
                    style="@style/SecondaryButton"
                    android:textColor="@color/danger"
                    android:text="@string/setting_reset_title" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/settings_text_secondary"
                android:textSize="11sp"
                android:text="@string/about_footer" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
