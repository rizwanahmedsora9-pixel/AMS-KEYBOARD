<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_background"
    android:orientation="vertical">

    <!-- Resize handle: drag up/down to change the keyboard height. It is a leaf view, so it
         receives every touch event reliably (no child steals the gesture). -->
    <View
        android:id="@+id/resize_handle"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:background="@drawable/bg_resize_handle"
        android:contentDescription="@string/setting_keyboard_height_title" />

    <!-- Suggestion strip: word predictions plus the PC-style shortcut row. -->
    <LinearLayout
        android:id="@+id/suggestion_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/suggestion_strip_height"
        android:background="@color/suggestion_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:id="@+id/suggestion_row"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/suggestion_empty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:text="@string/suggestion_idle"
            android:textColor="@color/key_hint"
            android:textSize="13sp" />

        <!-- Ctrl / Alt / undo row. Hidden when the user turns it off in settings. -->
        <LinearLayout
            android:id="@+id/quick_shortcut_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <ImageButton
            android:id="@+id/suggestion_settings"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_settings"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            android:tint="@color/toolbar_icon" />
    </LinearLayout>

    <!-- Compact shortcuts row: panels + PC clipboard tools + settings. -->
    <LinearLayout
        android:id="@+id/keyboard_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/ime_toolbar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/toolbar_tools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_tools"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tools"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_emoji"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_emoji"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_emoji"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_clipboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_clipboard"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_clipboard"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_shortcuts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_shortcuts"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_shortcut"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_copy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_copy"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_copy"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_paste"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_paste"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_paste"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_keyboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_keyboard"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_keyboard"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_settings"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            android:tint="@color/toolbar_icon" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/keyboard_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <android.inputmethodservice.KeyboardView
            android:id="@+id/keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ime_background"
            android:keyBackground="@drawable/key_background"
            android:keyTextColor="@color/key_text"
            android:keyTextSize="@dimen/key_text_size"
            android:labelTextSize="12sp"
            android:keyPreviewLayout="@layout/keyboard_key_preview"
            android:keyPreviewHeight="70dip"
            android:shadowColor="#00000000"
            android:shadowDx="0.0"
            android:shadowDy="0.0"
            android:shadowRadius="0.0" />

        <LinearLayout
            android:id="@+id/tools_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ime_background"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="@string/quick_tools_title"
                android:textColor="@color/toolbar_icon"
                android:textSize="15sp" />

            <GridLayout
                android:id="@+id/tools_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="4"
                android:rowCount="3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shortcut_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ime_background"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="@string/snippets_hint"
                android:textColor="@color/key_hint"
                android:textSize="12sp" />

            <GridView
                android:id="@+id/shortcut_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnWidth="92dp"
                android:horizontalSpacing="6dp"
                android:numColumns="auto_fit"
                android:stretchMode="columnWidth"
                android:verticalSpacing="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ime_background"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="@string/emoji_title"
                android:textColor="@color/toolbar_icon"
                android:textSize="15sp" />

            <GridLayout
                android:id="@+id/emoji_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="8"
                android:rowCount="4" />
        </LinearLayout>
    </FrameLayout>

    <!-- Clipboard history replaces the keyboard controls while browsing clips. -->
    <LinearLayout
        android:id="@+id/clipboard_panel"
        android:layout_width="match_parent"
        android:layout_height="286dp"
        android:background="@color/ime_background"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/ime_toolbar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/clipboard_back"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/clipboard_back"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/toolbar_icon"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/clipboard_title"
                android:textColor="@color/toolbar_icon"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/clipboard_count"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:text="@string/clipboard_count_zero"
                android:textColor="@color/toolbar_icon"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/clipboard_enabled"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/clipboard_history_on"
                android:showText="false" />

            <ImageButton
                android:id="@+id/clipboard_clear"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clipboard_clear"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                android:tint="@color/toolbar_icon" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/clipboard_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/clipboard_empty"
                    android:textColor="@color/toolbar_icon"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/clipboard_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp" />
            </FrameLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
