<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_background"
    android:orientation="vertical"
    android:clipToPadding="false">

    <!-- Compact shortcuts row inspired by the keyboard toolbar in the references. -->
    <LinearLayout
        android:id="@+id/keyboard_toolbar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/ime_toolbar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/toolbar_tools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_tools"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tools"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_emoji"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_emoji"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_emoji"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_clipboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_clipboard"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_clipboard"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_copy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_copy"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_copy"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_paste"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_paste"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_paste"
            android:tint="@color/toolbar_icon" />

        <ImageButton
            android:id="@+id/toolbar_keyboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_keyboard"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_keyboard"
            android:tint="@color/toolbar_icon" />
    </LinearLayout>

    <!-- Number hints sit over the QWERTY row, as in the reference layout. -->
    <LinearLayout
        android:id="@+id/number_hints"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:background="@color/ime_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="1" android:textColor="@color/key_hint" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="2" android:textColor="@color/key_hint" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="3" android:textColor="@color/key_hint" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="4" android:textColor="@color/key_hint" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="5" android:textColor="@color/key_hint" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="6" android:textColor="@color/key_hint" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="7" android:textColor="@color/key_hint" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="8" android:textColor="@color/key_hint" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="9" android:textColor="@color/key_hint" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="0" android:textColor="@color/key_hint" android:textSize="11sp" />
    </LinearLayout>

    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ime_background"
        android:keyBackground="@drawable/key_background"
        android:keyTextColor="@color/key_text"
        android:keyTextSize="21sp"
        android:keyPreviewLayout="@layout/keyboard_key_preview"
        android:keyPreviewHeight="70dip"
        android:shadowColor="#00000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="0.0" />

    <LinearLayout
        android:id="@+id/tools_panel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/ime_background"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:text="@string/quick_tools_title"
            android:textColor="@color/toolbar_icon"
            android:textSize="15sp" />

        <GridLayout
            android:id="@+id/tools_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:columnCount="3"
            android:rowCount="2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emoji_panel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/ime_background"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="@string/emoji_title"
            android:textColor="@color/toolbar_icon"
            android:textSize="15sp" />

        <GridLayout
            android:id="@+id/emoji_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:columnCount="8"
            android:rowCount="4" />
    </LinearLayout>

    <!-- Clipboard history replaces the keyboard controls while browsing clips. -->
    <LinearLayout
        android:id="@+id/clipboard_panel"
        android:layout_width="match_parent"
        android:layout_height="286dp"
        android:background="@color/ime_background"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/ime_toolbar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/clipboard_back"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/clipboard_back"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/toolbar_icon"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/clipboard_title"
                android:textColor="@color/toolbar_icon"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/clipboard_count"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:text="0/50"
                android:textColor="@color/toolbar_icon"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/clipboard_enabled"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/clipboard_history_on"
                android:showText="false" />

            <ImageButton
                android:id="@+id/clipboard_clear"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clipboard_clear"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                android:tint="@color/toolbar_icon" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/clipboard_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/clipboard_empty"
                    android:textColor="@color/toolbar_icon"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/clipboard_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp" />
            </FrameLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
